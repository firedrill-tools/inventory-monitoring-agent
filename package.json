{
  "name": "inventory-monitoring-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "postinstall": "node scripts/patch-argparse.cjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "inventory": "node dist/src/cli.js",
    "inventory:state": "node dist/src/managed-cli.js",
    "inventory:cases": "node dist/src/cases-cli.js",
    "check:populations": "node scripts/build-populations.mjs --check",
    "package:source": "npm run build && node scripts/package-source.mjs",
    "check:distribution": "node scripts/check-distribution.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "2.0.85",
    "@mastra/core": "1.77.0",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "gray-matter@4": {
      "js-yaml@3": {
        "argparse": "2.0.1"
      }
    }
  },
  "bin": {
    "inventory": "dist/src/cli.js",
    "inventory-state": "dist/src/managed-cli.js",
    "inventory-cases": "dist/src/cases-cli.js"
  },
  "files": [
    "dist/src",
    "src",
    "tests",
    "scripts",
    "fixtures",
    "scenarios",
    ".github",
    "README.md",
    "AGENTS.md",
    "PLAN.md",
    "COMPATIBILITY.md",
    "tsconfig.json",
    "npm-shrinkwrap.json"
  ]
}
