{
  "name": "inventory-monitoring-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "postinstall": "node scripts/patch-argparse.cjs",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "inventory": "node dist/src/cli.js",
    "inventory:state": "node dist/src/managed-cli.js"
  },
  "dependencies": {
    "@ai-sdk/google": "2.0.85",
    "@mastra/core": "1.77.0",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "gray-matter@4": {
      "js-yaml@3": {
        "argparse": "2.0.1"
      }
    }
  }
}
